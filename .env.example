# Prismic environment (optional — falls back to slicemachine.config.json repositoryName)
VITE_PRISMIC_ENVIRONMENT=

# Fleet forms: forward contact submissions to the central dashboard ingest
# endpoint. Set BOTH on the deployed site (plural names). The token is the SAME
# value as the dashboard's FORMS_INGEST_TOKEN; the URL ends in this site's slug
# (derived from the Airtable Websites `Name`, e.g. .../api/forms/acme).
FORMS_INGEST_URL=https://reddoor-maintenance.netlify.app/api/forms/<slug>
FORMS_INGEST_TOKEN=replace-with-the-shared-forms-ingest-token

# Cloudflare Turnstile (optional contact-form anti-bot). Public site key — safe to
# expose in HTML. Leave unset to keep the widget off (honeypot + fill-timing still
# apply). Verification runs centrally in the dashboard, which holds the secret, so a
# site needs only this public key. Create a widget at dash.cloudflare.com → Turnstile
# and add the site's apex + www hostnames.
PUBLIC_TURNSTILE_SITE_KEY=

# The map's vector tile style (#13). Unset — the default is OpenFreeMap's Liberty
# style, which needs no key and no account, and is what the site ships. Set it to
# swap providers without touching code: the ONE other change a swap needs is the
# host in `connect-src` (svelte.config.js), because MapLibre fetches the style,
# the TileJSON, the tiles, the sprite sheet and the glyph ranges with fetch() —
# never as an <img> or a webfont. See docs/security.md. An empty string is the
# documented no-op and falls back to the default.
PUBLIC_MAP_STYLE_URL=
