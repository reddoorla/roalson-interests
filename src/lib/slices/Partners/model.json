{
  "id": "partners",
  "type": "SharedSlice",
  "name": "Partners",
  "description": "The homepage's \"Our Legacy\" band: an eyebrow over the partner cards on the left, a headline and body copy on the right",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Partner cards — each one a partner's Person page, which holds the name, role, headshot and email — beside a headline and body copy",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow — the small label over the partner cards",
            "placeholder": "Our legacy"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Headline",
            "placeholder": "Representing Your Best Interests in Acquisition and Disposition",
            "single": "heading2"
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Body",
            "placeholder": "Roalson Interests was formed in 1983…",
            "multi": "paragraph,strong,em,hyperlink",
            "allowTargetBlank": true
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Buttons under the body (optional — the design has none; the first two are shown)",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "e.g. Properties"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link — a page on this site can be typed as a path, e.g. /properties",
                  "placeholder": "/properties",
                  "allowTargetBlank": true
                }
              }
            }
          }
        },
        "partners": {
          "type": "Group",
          "config": {
            "label": "Partners",
            "repeat": true,
            "fields": {
              "profile": {
                "type": "Link",
                "config": {
                  "label": "Partner — their Person page, which supplies the card's name, title, headshot and email. A card whose Person is unpublished is not shown",
                  "select": "document",
                  "customtypes": [
                    {
                      "id": "person",
                      "fields": ["name", "role", "photo", "email"]
                    }
                  ]
                }
              },
              "contact_link": {
                "type": "Link",
                "config": {
                  "label": "CONTACT goes to (optional override) — mailto:, tel: or a page. Left empty, it mails the Person's email, else /contact",
                  "placeholder": "/contact",
                  "allowTargetBlank": false
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
