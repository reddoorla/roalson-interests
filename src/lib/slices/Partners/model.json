{
  "id": "partners",
  "type": "SharedSlice",
  "name": "Partners",
  "description": "The homepage's \"Our Legacy\" band: an eyebrow over the partner cards on the left, a headline and body copy on the right",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Partner cards (name, role, CONTACT, and PROFILE when there is a bio) beside a headline and body copy",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow — the small label over the partner cards",
            "placeholder": "Our legacy"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Headline",
            "placeholder": "Representing Your Best Interests in Acquisition and Disposition",
            "single": "heading2"
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Body",
            "placeholder": "Roalson Interests was formed in 1983…",
            "multi": "paragraph,strong,em,hyperlink",
            "allowTargetBlank": true
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Buttons under the body (optional — the design has none; the first two are shown)",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "e.g. Our portfolio"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link — a page on this site can be typed as a path, e.g. /properties",
                  "placeholder": "/properties",
                  "allowTargetBlank": true
                }
              }
            }
          }
        },
        "partners": {
          "type": "Group",
          "config": {
            "label": "Partners",
            "repeat": true,
            "fields": {
              "name": {
                "type": "Text",
                "config": {
                  "label": "Name",
                  "placeholder": "e.g. Matt Howard"
                }
              },
              "role": {
                "type": "Text",
                "config": {
                  "label": "Role",
                  "placeholder": "Partner"
                }
              },
              "photo": {
                "type": "Image",
                "config": {
                  "label": "Headshot (square crop) — left empty, the card is text only",
                  "constraint": {
                    "width": 612,
                    "height": 612
                  },
                  "thumbnails": []
                }
              },
              "contact_link": {
                "type": "Link",
                "config": {
                  "label": "CONTACT goes to — mailto:, tel: or a page. Left empty, it goes to /contact",
                  "placeholder": "/contact",
                  "allowTargetBlank": false
                }
              },
              "bio": {
                "type": "StructuredText",
                "config": {
                  "label": "Bio — PROFILE appears on the card only when this is filled",
                  "placeholder": "A few paragraphs about this partner",
                  "multi": "paragraph,strong,em,hyperlink",
                  "allowTargetBlank": true
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
