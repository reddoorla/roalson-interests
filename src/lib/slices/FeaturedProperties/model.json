{
  "id": "featured_properties",
  "type": "SharedSlice",
  "name": "FeaturedProperties",
  "description": "Homepage band: a slideshow of hand-picked listings beside the (reserved) map column",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Featured listings, one at a time, auto-advancing with a pause control",
      "imageUrl": "",
      "primary": {
        "show_featured": {
          "type": "Boolean",
          "config": {
            "label": "Show featured properties — turned off, this whole section is removed from the page",
            "placeholder_true": "Shown",
            "placeholder_false": "Hidden",
            "default_value": true
          }
        },
        "heading": {
          "type": "Text",
          "config": {
            "label": "Heading — left empty it reads “Featured Properties”",
            "placeholder": "Featured Properties"
          }
        },
        "properties": {
          "type": "Group",
          "config": {
            "label": "Featured listings — up to 10, shown in this order; any after the tenth are not shown",
            "repeat": true,
            "fields": {
              "property": {
                "type": "Link",
                "config": {
                  "label": "Listing",
                  "select": "document",
                  "placeholder": "Pick a listing — only listings with a feature image are shown; past projects and archived listings are skipped",
                  "customtypes": [
                    {
                      "id": "property",
                      "fields": [
                        "title",
                        "status",
                        "listing_state",
                        "size_label",
                        "feature_image",
                        {
                          "id": "highlights",
                          "fields": ["text"]
                        },
                        "location"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "portfolio_label": {
          "type": "Text",
          "config": {
            "label": "Properties button — label. With no label or no link the button is not shown",
            "placeholder": "Properties"
          }
        },
        "portfolio_link": {
          "type": "Link",
          "config": {
            "label": "Properties button — link. A page on this site can be typed as a path, e.g. /properties",
            "placeholder": "/properties",
            "allowTargetBlank": true
          }
        }
      },
      "items": {}
    }
  ]
}
