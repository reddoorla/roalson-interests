{
  "id": "home_hero",
  "type": "SharedSlice",
  "name": "HomeHero",
  "description": "The top of the homepage: a pinned 528px hero, the RI cutout, and the garnet band with the headline, two buttons and the specialty list",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Pinned hero (poster image, optional Vimeo clip) with the garnet headline band sliding over it",
      "imageUrl": "",
      "primary": {
        "poster": {
          "type": "Image",
          "config": {
            "label": "Hero poster — a wide photo (16:9 or wider). Left empty, the hero is the dark garnet ground",
            "constraint": {},
            "thumbnails": []
          }
        },
        "vimeo_id": {
          "type": "Text",
          "config": {
            "label": "Hero video — Vimeo ID (digits only). Plays over the poster",
            "placeholder": "e.g. 123456789"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Headline — Shift+Enter for a line break",
            "placeholder": "San Antonio's Commercial Real Estate Experts. Since 1983.",
            "single": "heading1"
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Buttons (the first two are shown)",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "e.g. Contact us"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link — a page on this site can be typed as a path, e.g. /contact",
                  "placeholder": "/contact",
                  "allowTargetBlank": true
                }
              }
            }
          }
        },
        "specialty_label": {
          "type": "Text",
          "config": {
            "label": "List label",
            "placeholder": "Our specialty"
          }
        },
        "specialties": {
          "type": "Group",
          "config": {
            "label": "Specialties",
            "repeat": true,
            "fields": {
              "text": {
                "type": "Text",
                "config": {
                  "label": "Specialty",
                  "placeholder": "e.g. Consulting and brokerage"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
