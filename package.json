{
  "name": "roalson-interests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "verify": "pnpm lint && pnpm check && pnpm build && pnpm test:a11y && pnpm test",
    "dev": "concurrently \"pnpm:vite:dev\" \"pnpm:slicemachine\" --prefix-colors blue,magenta",
    "vite:dev": "vite dev --host",
    "build": "vite build && node scripts/publish-check.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "simple-git-hooks",
    "test": "pnpm test:unit && pnpm test:smoke",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:smoke": "playwright install chromium && playwright test --grep @smoke",
    "test:nightly": "playwright test tests/interaction/property-map-camera.spec.ts tests/interaction/property-map-camera-prod.spec.ts tests/interaction/property-map-scroll-zoom.spec.ts tests/interaction/property-map-band-lock.spec.ts tests/interaction/property-map-press-direct.spec.ts tests/interaction/map-featured-pin.spec.ts tests/interaction/map-home.spec.ts tests/interaction/featured-band-live.spec.ts tests/interaction/featured-properties.spec.ts tests/interaction/carousel.spec.ts tests/interaction/reveal-no-js.spec.ts tests/interaction/property-map.spec.ts tests/interaction/listing-carousel.spec.ts tests/interaction/photo-band.spec.ts tests/interaction/home-hero.spec.ts tests/interaction/listing-views.spec.ts tests/interaction/listing-view-first.spec.ts tests/interaction/properties-map-still.spec.ts tests/interaction/properties-list.spec.ts",
    "test:scaffold": "playwright test --grep-invert @smoke",
    "test:e2e": "playwright test",
    "test:a11y": "reddoor-maint audit --only a11y --fail-on-violations",
    "map:style": "node scripts/map-style.mjs",
    "map:home": "node scripts/map-home.mjs",
    "slicemachine": "start-slicemachine"
  },
  "reddoor": {
    "a11yRoutes": [
      "/",
      "/properties",
      "/contact",
      "/privacy",
      "/team/matt-howard",
      "/team/bart-wilson",
      "/properties/101-w-commerce-street"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@slicemachine/adapter-sveltekit": "^0.3.96",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.18.0",
    "globals": "^17.6.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "sharp": "^0.35.0",
    "simple-git-hooks": "^2.14.0",
    "slice-machine-ui": "^2.21.3",
    "svelte": "^5.55.10",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@prismicio/client": "^7.21.8",
    "@prismicio/svelte": "^2.2.1",
    "@reddoorla/maintenance": "^0.102.0",
    "@tailwindcss/vite": "^4.3.0",
    "@zerodevx/svelte-img": "^2.1.2",
    "maplibre-gl": "6.10.0",
    "svelte-gestures": "^5.2.2"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -x node_modules/.bin/lint-staged ]; then node_modules/.bin/lint-staged; else echo \"pre-commit: node_modules is not installed in this checkout, so prettier did not run\"; fi"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
